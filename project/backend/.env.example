# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Database Configuration
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=network_monitor_db

# Security & Admin Authentication
SECRET_KEY=change-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Device Discovery & Background Synchronization
DEVICE_SYNC_INTERVAL=10
ROUTER_TYPE=arp_subnet

# Jio Router Configuration (Used only when ROUTER_TYPE=jio)
JIO_ROUTER_IP=192.168.29.1
JIO_ROUTER_USERNAME=admin
JIO_ROUTER_PASSWORD=
SUBNET_CIDR=
